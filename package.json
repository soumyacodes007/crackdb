{
  "name": "crackdb",
  "version": "1.1.0",
  "description": "A lightweight, file-based vector database microservice.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vector-db",
    "crackdb",
    "semantic-search",
    "embeddings",
    "typescript",
    "rag"
